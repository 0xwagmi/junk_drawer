+static void
+elanspi_dump_pgm (FpImage *img, const char *tag)
+{
+  const gchar *dir = g_getenv ("ELANSPI_DUMP_DIR");
+  static guint counter = 0;
+  gsize len;
+  const guchar *data;
+  guint w, h;
+  g_autofree gchar *path = NULL;
+  FILE *f;
+
+  if (!dir)
+    return;
+
+  data = fp_image_get_data (img, &len);
+  w = fp_image_get_width (img);
+  h = fp_image_get_height (img);
+  if (!data || !w || !h)
+    return;
+
+  counter += 1;
+  path = g_strdup_printf ("%s/%s-%04u-%ux%u.pgm", dir, tag, counter, w, h);
+  f = fopen (path, "wb");
+  if (!f)
+    return;
+
+  fprintf (f, "P5\n%u %u\n255\n", w, h);
+  fwrite (data, 1, MIN (len, (gsize) w * h), f);
+  fclose (f);
+  fp_dbg ("dumped image to %s", path);
+}
+
+static void
+elanspi_dump_frame (struct fpi_frame *frame, guint fw, guint fh, const char *tag)
+{
+  const gchar *dir = g_getenv ("ELANSPI_DUMP_DIR");
+  static guint counter = 0;
+  g_autofree gchar *path = NULL;
+  FILE *f;
+
+  if (!dir || !frame)
+    return;
+
+  counter += 1;
+  path = g_strdup_printf ("%s/%s-%04u-%ux%u.pgm", dir, tag, counter, fw, fh);
+  f = fopen (path, "wb");
+  if (!f)
+    return;
+  fprintf (f, "P5\n%u %u\n255\n", fw, fh);
+  for (guint y = 0; y < fh; y++)
+    for (guint x = 0; x < fw; x++)
+      fputc (frame->data[y * fw + x], f);
+  fclose (f);
+  fp_dbg ("dumped frame to %s", path);
+}
