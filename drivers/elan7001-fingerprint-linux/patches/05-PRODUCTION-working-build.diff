+/* Optional ridge enhancement before NBIS minutiae detection (opt-in via FP_ENHANCE_RIDGES).
+ * Gabor filter bank, max response across orientations; FP_ENHANCE_LAMBDA / FP_ENHANCE_ORIENT
+ * override the defaults. Operates on the raw driver image (before inversion) - exactly how it was
+ * validated offline. Runs in the detection worker thread, so driver/SPI timing is unaffected. */
+static void
+ridge_enhance (unsigned char *data, int w, int h)
+{
+  const gchar *env;
+  double lambda = 11.5;
+  int norient = 12;
+  int R, ksize, o, y, x;
+  double sigma;
+  unsigned char *acc;
+  int mx = 1;
+  int i;
+
+  if ((env = g_getenv ("FP_ENHANCE_LAMBDA")))
+    lambda = g_ascii_strtod (env, NULL);
+  if ((env = g_getenv ("FP_ENHANCE_ORIENT")))
+    norient = atoi (env);
+  if (norient < 4 || lambda < 3.0)
+    return;
+
+  R = (int) (0.75 * lambda) + 1;
+  ksize = 2 * R + 1;
+  sigma = 0.55 * lambda;
+  acc = g_malloc0 ((gsize) w * h);
+
+  for (o = 0; o < norient; o++)
+    {
+      double th = M_PI * o / norient;
+      double ct = cos (th), st = sin (th);
+      double *k = g_malloc0 (sizeof (double) * ksize * ksize);
+      double ksum = 0.0;
+
+      for (y = -R; y <= R; y++)
+        for (x = -R; x <= R; x++)
+          {
+            double xr = x * ct + y * st;
+            double yr = -x * st + y * ct;
+            double g = exp (-(xr * xr + yr * yr) / (2.0 * sigma * sigma)) * cos (2.0 * M_PI * xr / lambda);
+            k[(y + R) * ksize + (x + R)] = g;
+            ksum += fabs (g);
+          }
+      if (ksum <= 0.0)
+        {
+          g_free (k);
+          continue;
+        }
+      for (i = 0; i < ksize * ksize; i++)
+        k[i] /= ksum;
+
+      for (y = 0; y < h; y++)
+        for (x = 0; x < w; x++)
+          {
+            double s = 0.0;
+            unsigned char b;
+            int dy, dx;
+            for (dy = -R; dy <= R; dy++)
+              {
+                int yy = CLAMP (y + dy, 0, h - 1);
+                for (dx = -R; dx <= R; dx++)
+                  {
+                    int xx = CLAMP (x + dx, 0, w - 1);
+                    s += k[(dy + R) * ksize + (dx + R)] * ((int) data[yy * w + xx] - 128);
+                  }
+              }
+            s = fabs (s);
+            b = (unsigned char) (s > 255.0 ? 255.0 : s);
+            if (b > acc[y * w + x])
+              acc[y * w + x] = b;
+          }
+      g_free (k);
+    }
+
+  for (i = 0; i < w * h; i++)
+    if (acc[i] > mx)
+      mx = acc[i];
+  for (i = 0; i < w * h; i++)
+    data[i] = (unsigned char) (255.0 * acc[i] / mx);
+  g_free (acc);
+}
